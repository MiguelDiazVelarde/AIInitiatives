{
  "name": "academia-con-ia",
  "version": "1.0.0",
  "description": "Courses app with login and student progress tracking",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "node node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "build:client": "cd client && node node_modules/vite/bin/vite.js build",
    "start": "node dist/server/index.js",
    "start:test": "node dist/server/test-server.js",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "node --watch -r ts-node/register src/server/index.ts",
    "dev:client": "cd client && node node_modules/vite/bin/vite.js",
    "clean": "node node_modules/rimraf/dist/esm/bin.mjs dist client/dist",
    "test": "pnpm run test:cucumber",
    "test:cucumber": "node node_modules/@cucumber/cucumber/bin/cucumber.js tests/features --require-module ts-node/register --require tests/step-definitions/**/*.ts --format progress-bar --format json:reports/cucumber_report.json",
    "test:playwright": "node node_modules/@playwright/test/cli.js test",
    "test:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "test:debug": "node node_modules/@playwright/test/cli.js test --debug",
    "test:headed": "HEADLESS=false pnpm run test:cucumber",
    "test:report": "node generate-report.js",
    "test:full": "pnpm run test:cucumber && pnpm run test:report",
    "test:auth": "node node_modules/@cucumber/cucumber/bin/cucumber.js tests/features/functional-requirements/authentication/authentication.feature --require-module ts-node/register --require tests/step-definitions/**/*.ts --format progress-bar",
    "test:auth:session": "node node_modules/@cucumber/cucumber/bin/cucumber.js tests/features/functional-requirements/authentication/authentication.feature --require-module ts-node/register --require tests/step-definitions/**/*.ts --format progress-bar --grep \"Session persistence\"",
    "test:courses:cucumber": "node node_modules/@cucumber/cucumber/bin/cucumber.js tests/features/functional-requirements/course-progress/course-progress.feature --require-module ts-node/register --require tests/step-definitions/**/*.ts",
    "test:courses": "pnpm run build && node node_modules/start-server-and-test/src/bin/start.js \"node dist/server/test-server.js\" http-get://localhost:3002 \"pnpm run test:courses:cucumber\"",
    "test:navigation": "node node_modules/@cucumber/cucumber/bin/cucumber.js tests/features/functional-requirements/user-interface/navigation.feature --require-module ts-node/register --require tests/step-definitions/**/*.ts",
    "test:smoke": "pnpm run test:auth",
    "test:health": "echo 'Running health check tests...'     && pnpm run build && echo 'Build successful'",
        "ci:check": "pnpm run ci:build && pnpm run ci:test && pnpm run ci:security",
        "ci:build": "echo '🔨 Building...' && pnpm run build",
        "ci:test": "echo '🧪 Testing...' && pnpm run test:smoke",
        "ci:security": "echo '🔒 Security check...' && pnpm audit --audit-level high",
        "ci:quick": "pnpm run build && pnpm run test:smoke",
        "ci:full": "pnpm run ci:check && echo '✅ All CI checks passed!'",
        "pre-commit": "pnpm run ci:quick && echo '✅ Ready to commit!'",
        "pre-push": "pnpm run ci:full && echo '✅ Ready to push!'",
    "agent:demo": "node -r ts-node/register src/agent/demo.ts",
    "optimizer:smoke": "node -r ts-node/register src/test-optimizer/index.ts smoke",
    "optimizer:quick": "node -r ts-node/register src/test-optimizer/index.ts optimize quick",
    "optimizer:balanced": "node -r ts-node/register src/test-optimizer/index.ts optimize balanced",
    "optimizer:comprehensive": "node -r ts-node/register src/test-optimizer/index.ts optimize comprehensive",
    "optimizer:stats": "node -r ts-node/register src/test-optimizer/index.ts stats",
    "optimizer:server": "node -r ts-node/register src/test-optimizer/index.ts server",
    "optimizer:config": "node -r ts-node/register src/test-optimizer/index.ts config show",
    "optimizer:analyze": "node -r ts-node/register src/test-optimizer/index.ts analyze",
    "optimizer:recommendations": "node -r ts-node/register src/test-optimizer/index.ts recommendations",
    "optimizer:execute": "node -r ts-node/register src/test-optimizer/index.ts execute",
    "optimizer:report": "node -r ts-node/register src/test-optimizer/index.ts report",
    "optimizer:pr": "node -r ts-node/register src/test-optimizer/index.ts analyze-pr",
    "optimizer:debug": "node --inspect-brk -r ts-node/register src/test-optimizer/index.ts",
    "optimizer:debug:quick": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=test-optimizer:* node -r ts-node/register src/test-optimizer/index.ts optimize quick",
    "optimizer:debug:stats": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=test-optimizer:* node -r ts-node/register src/test-optimizer/index.ts stats",
    "optimizer:debug:server": "node --inspect -r ts-node/register src/test-optimizer/index.ts server 3001",
    "optimizer:metrics": "node -r ts-node/register src/test-optimizer/index.ts metrics",
    "optimizer:init": "node -r ts-node/register src/test-optimizer/index.ts config init",
    "server:debug": "node --inspect-brk -r ts-node/register src/server/index.ts",
    "server:debug:auth": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=server:auth:* node --watch --inspect -r ts-node/register src/server/index.ts",
    "server:debug:courses": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=server:courses:* node --watch --inspect -r ts-node/register src/server/index.ts",
    "server:debug:api": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=server:api:* node --watch --inspect -r ts-node/register src/server/index.ts",
    "client:debug": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=client:* pnpm run dev:client",
    "client:debug:build": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=client:* pnpm run build:client",
    "client:debug:preview": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=client:* node client/node_modules/vite/bin/vite.js preview client",
    "fullstack:debug": "node node_modules/cross-env/src/bin/cross-env.js DEBUG=server:*,client:* pnpm run dev"
  },
  "keywords": [
    "typescript",
    "express",
    "login",
    "courses"
  ],
  "author": "MiguelDiazVelarde",
  "license": "MIT",
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/pretty-formatter": "^2.3.0",
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/node": "^20.4.5",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "cucumber-html-reporter": "^5.0.2",
    "nodemon": "^3.0.1",
    "rimraf": "^6.1.4",
    "start-server-and-test": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6",
    "vite": "^8.2.2",
    "wait-on": "^9.0.5"
  }
}
